# URL the server uses to reach Mealie (internal address is fine, e.g. http://mealie:9000)
MEALIE_URL=http://mealie:9925

# URL you open Mealie with on the phone (used for the "Apri in Mealie" button). Defaults to MEALIE_URL.
MEALIE_PUBLIC_URL=https://mealie.example.com

# Mealie → Profilo → Token API → Genera.
# Better: create a dedicated non-admin Mealie user for this app and generate the token there.
MEALIE_API_TOKEN=

# Tag added to every imported recipe (empty = no tag)
MEALIE_TAG=Instagram

# Show the "Importa con l'AI di Mealie" button (needs an AI provider configured in Mealie)
MEALIE_AI=false

# Access code asked once by the app. Strongly recommended (required if reachable from the internet).
# Use a long random value, e.g.: openssl rand -hex 24
APP_TOKEN=

# Optional: Instagram cookies file inside the container (see README)
# INSTAGRAM_COOKIES_FILE=/srv/instagram-cookies.txt
